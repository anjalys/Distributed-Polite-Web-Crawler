# Copy to .env and adjust as needed. .env is gitignored.

REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/crawler

# Comma-separated lists
SEED_URLS=https://quotes.toscrape.com/
ALLOWED_DOMAINS=quotes.toscrape.com

MAX_WORKERS=5
POLITE_DELAY=1.0
DEPTH_LIMIT=3

# Connection pool sizing (per process). Postgres defaults to MAX_WORKERS
# (asyncpg queues callers gracefully at capacity). Redis defaults to
# MAX_WORKERS*2+5 (redis-py's pool raises instead of queuing when full, so
# it needs headroom). Only override if you want different sizing.
# POSTGRES_POOL_MAX_SIZE=5
# REDIS_MAX_CONNECTIONS=15
