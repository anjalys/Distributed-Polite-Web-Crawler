# Copy to .env and adjust as needed. .env is gitignored.

REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/crawler

# Comma-separated lists
SEED_URLS=https://quotes.toscrape.com/
ALLOWED_DOMAINS=quotes.toscrape.com

MAX_WORKERS=5
POLITE_DELAY=1.0
DEPTH_LIMIT=3
